# Standard Prisma Postgres connection string.
# Replace USER, PASSWORD, HOST, PORT, and DB_NAME for your environment.
# Neon example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thermal_lead_tracker?schema=public"
APP_URL="http://localhost:3000"
SEED_DEMO_DATA="true"
DEFAULT_MARKET_NAME="Cedar Rapids Corridor"
ENABLE_DEMO_FIXTURES="true"
